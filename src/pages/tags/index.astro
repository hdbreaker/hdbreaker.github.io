---
import Breadcrumb from '@/components/Breadcrumb.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { tagGroups } from '@/site-config'
import { getListedPosts, getUniqueTagsWithCount } from '@/utils'

const allPosts = await getListedPosts()
const counts = new Map(getUniqueTagsWithCount(allPosts))

// Build the grouped view from the vocabulary, keeping only tags that are actually
// in use, and ordering each group by how much has been written about it.
const groups = tagGroups
	.map((group) => ({
		...group,
		entries: group.tags
			.filter((tag) => counts.has(tag))
			.map((tag) => ({ tag, count: counts.get(tag)! }))
			.sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
	}))
	.filter((group) => group.entries.length > 0)

// Anything in use but outside the vocabulary — surfaced rather than hidden.
const known = new Set(tagGroups.flatMap((g) => g.tags))
const orphans = [...counts.entries()]
	.filter(([tag]) => !known.has(tag))
	.map(([tag, count]) => ({ tag, count }))
	.sort((a, b) => b.count - a.count)

if (orphans.length) {
	groups.push({
		title: 'Other',
		blurb: 'Outside the controlled vocabulary.',
		tags: [],
		entries: orphans
	})
}

const meta = {
	title: 'Topics',
	description: 'Browse the research by vulnerability class, technique or domain.'
}
---

<PageLayout meta={meta}>
	<div class='w-full'>
		<Breadcrumb
			items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: 'Topics' }]}
		/>

		<h1 class='mb-2 mt-5 text-2xl font-bold'>Topics</h1>
		<p class='mb-10 max-w-[60ch] text-muted-foreground'>
			A tag names the technique or the vulnerability class. Affected products and CVE numbers are
			not tags — they live on each post. The number beside a tag is how many writeups carry it.
		</p>

		{groups.length === 0 && <p class='text-muted-foreground'>No posts yet.</p>}

		<div class='flex flex-col gap-10'>
			{
				groups.map((group) => (
					<section>
						<h2 class='font-mono text-xs uppercase tracking-widest text-muted-foreground'>
							{group.title}
						</h2>
						<p class='mb-4 mt-1 text-sm text-muted-foreground/70'>{group.blurb}</p>

						<ul class='flex flex-wrap gap-2'>
							{group.entries.map(({ tag, count }) => (
								<li>
									<a
										aria-label={`${count} ${count === 1 ? 'post' : 'posts'} tagged ${tag}`}
										class='group inline-flex items-center gap-x-2 rounded border border-border px-3 py-1.5 font-mono text-sm text-foreground/80 transition-colors hover:border-primary/40 hover:text-foreground'
										data-astro-prefetch
										href={`/tags/${tag}/`}
									>
										{tag}
										<span class='text-xs text-muted-foreground group-hover:text-primary'>
											{count}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</PageLayout>
