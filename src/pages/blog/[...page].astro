---
export const prerender = true

import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import Breadcrumb from '@/components/Breadcrumb.astro'
import Pagination from '@/components/Paginator.astro'
import PostCard from '@/components/blog/PostCard.astro'
import Search from '@/components/blog/Search.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts, getListedPosts, sortMDByDate } from '@/utils'

export const getStaticPaths = (async ({ paginate }) => {
	const listed = sortMDByDate(await getListedPosts())

	// Chapter counts per series, so a series entry point can advertise its length.
	// Counted over all posts, since inner chapters are unlisted, and only in one
	// language so a translated series is not counted twice.
	const all = await getAllPosts()
	const seriesLengths: Record<string, number> = {}
	for (const post of all) {
		const { series, lang } = post.data
		if (series && lang !== 'es') seriesLengths[series] = (seriesLengths[series] ?? 0) + 1
	}

	return paginate(listed, { pageSize: 12, props: { seriesLengths } })
}) satisfies GetStaticPaths

interface Props {
	page: Page<CollectionEntry<'post'>>
	seriesLengths: Record<string, number>
}

const { page, seriesLengths } = Astro.props

// Paginated pages need distinct titles and descriptions, otherwise /blog/ and
// /blog/2 ship identical metadata and compete with each other in search results.
const meta = {
	description:
		page.currentPage > 1
			? `Vulnerability research and exploit writeups — page ${page.currentPage}.`
			: 'Vulnerability research, exploit development and offensive security writeups.',
	title:
		page.currentPage > 1 ? `Research & writeups — page ${page.currentPage}` : 'Research & writeups'
}

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: '← Newer posts', url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: 'Older posts →', url: page.url.next } })
}

const lengthOf = (post: CollectionEntry<'post'>) =>
	post.data.series ? seriesLengths[post.data.series] : undefined
---

<PageLayout meta={meta}>
	<div class='w-full'>
		<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />

		<h1 class='mb-2 mt-5 text-2xl font-bold'>Research &amp; writeups</h1>
		<p class='mb-6 max-w-[60ch] text-muted-foreground'>
			Vulnerability research, exploit development and the occasional side quest.
		</p>

		<Search />
		<p class='-mt-6 mb-8 text-end text-sm'>
			<a class='text-primary underline underline-offset-4' href='/tags/'>Or browse by topic →</a>
		</p>

		{page.data.length === 0 && <p class='text-muted-foreground'>No posts yet.</p>}

		{
			page.data.length > 0 && (
				<section aria-label='Posts' data-post-listing>
					<ul class='flex flex-col gap-4'>
						{page.data.map((post) => (
							<li>
								<PostCard post={post} seriesLength={lengthOf(post)} />
							</li>
						))}
					</ul>

					<Pagination {...paginationProps} />
				</section>
			)
		}
	</div>
</PageLayout>
