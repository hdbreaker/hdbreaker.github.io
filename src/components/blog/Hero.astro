---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '../FormattedDate.astro'
import Tag from '../Tag.astro'
import CveBadge from '../CveBadge.astro'
import LangSwitch from './LangSwitch.astro'

/**
 * Tags are metadata, not a headline. Five covers every post under the controlled
 * vocabulary, so the +N overflow link stays dormant unless a post exceeds it.
 */
const MAX_VISIBLE_TAGS = 5

interface Props {
	content: CollectionEntry<'post'>
}

const {
	content: { data, render }
} = Astro.props

const { remarkPluginFrontmatter } = await render()

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: 'long'
}
---

{data.draft ? <span class='text-red-500'>(Draft)</span> : null}
<div class='flex flex-wrap items-center gap-x-3 gap-y-2'>
	<p class='text-xs'>
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} /> /{' '}
		{remarkPluginFrontmatter.minutesRead}
	</p>
	<LangSwitch altSlug={data.altSlug} lang={data.lang} />
</div>
<h1 class='mt-2 text-3xl font-medium sm:mb-1'>
	{data.title}
</h1>

{
	(!!data.tags?.length || !!data.cve?.length || !!data.target) && (
		<div class='mt-4 flex flex-wrap items-center gap-2'>
			{/* CVEs first: they identify the finding, tags only categorise it. */}
			{data.cve?.map((id) => (
				<CveBadge id={id} />
			))}
			{data.target && (
				<span class='font-mono text-xs text-muted-foreground'>
					{[data.target.vendor, data.target.product].filter(Boolean).join(' · ')}
				</span>
			)}
			{data.tags.slice(0, MAX_VISIBLE_TAGS).map((tag) => (
				<Tag name={tag} />
			))}
			{data.tags.length > MAX_VISIBLE_TAGS && (
				<a
					aria-label={`View all ${data.tags.length} tags for this post`}
					class='font-mono text-xs text-muted-foreground transition-colors hover:text-foreground'
					href='/tags/'
				>
					+{data.tags.length - MAX_VISIBLE_TAGS}
				</a>
			)}
		</div>
	)
}

{
	data.updatedDate && (
		<p class='mt-6 text-base'>
			Last Updated:
			<FormattedDate class='ms-1' date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
		</p>
	)
}
