---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/app.css'

import type { SiteMeta } from '@/types'
import { siteConfig, socialLinks } from '@/site-config'

type Props = SiteMeta

const { altSlug, articleDate, description, keywords, lang, ogImage, publishDate, title, updatedDate } =
	Astro.props

const titleSeparator = '•'
// Skip the brand suffix when the page title already is the brand, so the home
// page does not render "Alejandro Parodi • Alejandro Parodi".
const siteTitle = !title
	? siteConfig.title
	: title === siteConfig.shortTitle
		? `${title} ${titleSeparator} Offensive Security Engineer`
		: `${title} ${titleSeparator} ${siteConfig.shortTitle}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : '/social-card.png', Astro.url).href

// --- Structured data -------------------------------------------------------
// The author is the same entity everywhere, so it is defined once and referenced
// by @id from the article node rather than duplicated.
const personId = new URL('/#person', Astro.site).href

const person = {
	'@type': 'Person',
	'@id': personId,
	name: siteConfig.author,
	url: new URL('/', Astro.site).href,
	jobTitle: 'Offensive Security Engineer',
	description: siteConfig.description,
	sameAs: socialLinks.filter((l) => l.url.startsWith('http')).map((l) => l.url)
}

const isArticle = !!publishDate

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		person,
		isArticle
			? {
					// TechArticle rather than BlogPosting: these are technical writeups.
					'@type': 'TechArticle',
					'@id': `${canonicalURL.href}#article`,
					headline: title,
					description,
					url: canonicalURL.href,
					datePublished: publishDate,
					dateModified: updatedDate ?? publishDate,
					inLanguage: lang === 'es' ? 'es' : 'en',
					image: socialImageURL,
					author: { '@id': personId },
					publisher: { '@id': personId },
					mainEntityOfPage: canonicalURL.href,
					...(keywords?.length ? { keywords: keywords.join(', ') } : {})
				}
			: {
					'@type': 'WebSite',
					'@id': new URL('/#website', Astro.site).href,
					url: new URL('/', Astro.site).href,
					name: siteConfig.title,
					description: siteConfig.description,
					inLanguage: 'en',
					publisher: { '@id': personId }
				}
	]
}
---

<meta charset='utf-8' />
<meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no' name='viewport' />
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon - Force cache refresh */}
<link rel="icon" href="/favicon.ico?v=3" type="image/x-icon" />
<link rel="shortcut icon" href="/favicon.ico?v=3" type="image/x-icon" />
<link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
<link rel='manifest' href='/favicon/site.webmanifest' />

{/* Font preloads */}
<link rel='preload' href='/fonts/Satoshi-Variable.ttf' as='font' type='font/ttf' crossorigin />
<link rel='preload' href='/fonts/Satoshi-VariableItalic.ttf' as='font' type='font/ttf' crossorigin />

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/*
  Reciprocal hreflang between translated posts. x-default points at the English
  version, so search engines serve it when the reader's language matches neither.
*/}
{
	altSlug && (
		<>
			<link
				href={new URL(`/blog/${altSlug}/`, Astro.site)}
				hreflang={lang === 'es' ? 'en' : 'es'}
				rel='alternate'
			/>
			<link href={canonicalURL} hreflang={lang === 'es' ? 'es' : 'en'} rel='alternate' />
			<link
				href={lang === 'es' ? new URL(`/blog/${altSlug}/`, Astro.site) : canonicalURL}
				hreflang='x-default'
				rel='alternate'
			/>
		</>
	)
}

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={siteConfig.author} name='author' />
<meta content='cybersecurity,offensive security,red team,penetration testing,vulnerability research,CVE,Nimhawk,Volt AI' name='keywords' />

{/* Theme Colour */}
<meta content='#0F111A' name='theme-color' />

{/* Open Graph / Facebook / WhatsApp / Instagram */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title || siteConfig.title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content='Alejandro Parodi' property='og:site_name' />
<meta content={siteConfig.ogLocale} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='en_US' property='og:locale:alternate' />
<meta content='es_ES' property='og:locale:alternate' />

{/* Instagram specific */}

{
	articleDate && (
		<>
			<meta content={siteConfig.author} property='article:author' />
			<meta content={articleDate} property='article:published_time' />
			<meta content='Technology' property='article:section' />
			<meta content='cybersecurity' property='article:tag' />
			<meta content='offensive security' property='article:tag' />
			<meta content='red team' property='article:tag' />
			<meta content='penetration testing' property='article:tag' />
			<meta content='vulnerability research' property='article:tag' />
		</>
	)
}

{/* Twitter / X */}
<meta content='summary_large_image' name='twitter:card' />
<meta content={canonicalURL} name='twitter:url' />
<meta content={title} name='twitter:title' />
<meta content={description} name='twitter:description' />
<meta content={socialImageURL} name='twitter:image' />
<meta content={`${title} - ${siteConfig.title}`} name='twitter:image:alt' />
<meta content='@hdbreaker_' name='twitter:creator' />
<meta content='@hdbreaker_' name='twitter:site' />
{/*
  Removed on purpose, do not add back:
  - twitter:app:name:* declared mobile apps that do not exist
  - twitter:domain, linkedin:owner and article:summary are not real properties
  - profile:* only applies when og:type is "profile"
  - whatsapp:* does not exist; WhatsApp reads Open Graph
  Several of them also shipped empty on every page.
*/}

{/* Additional SEO enhancements */}
<meta content='index, follow' name='robots' />
<meta content='Alejandro Parodi' name='copyright' />

{/* Structured data */}
<script is:inline type='application/ld+json' set:html={JSON.stringify(jsonLd)} />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link href='/rss.xml' rel='alternate' title={siteConfig.title} type='application/rss+xml' />

<meta content={Astro.generator} name='generator' />
