---
import type { SiteMeta } from '@/types'

import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import ThemeProvider from '@/components/ThemeProvider.astro'

import { siteConfig } from '@/site-config'

interface Props {
	meta: SiteMeta
}

const {
	meta: {
		altSlug,
		articleDate,
		description = siteConfig.description,
		keywords,
		lang,
		noindex,
		ogImage,
		publishDate,
		title,
		updatedDate
	}
} = Astro.props

// Spanish posts must not be served as English: it hurts SEO and screen readers.
const htmlLang = lang === 'es' ? 'es' : siteConfig.lang
---

<html lang={htmlLang} class='dark'>
	<head>
		<BaseHead
			altSlug={altSlug}
			articleDate={articleDate}
			description={description}
			keywords={keywords}
			lang={lang}
			noindex={noindex}
			ogImage={ogImage}
			publishDate={publishDate}
			title={title}
			updatedDate={updatedDate}
		/>
	</head>

	<body class='flex justify-center bg-[#0A0A0A] text-[#F5F5F5]'>
		<ThemeProvider />
		<main
			class='flex min-h-screen w-screen max-w-[70rem] flex-col items-center px-8 pb-16 pt-8 font-satoshi text-[1.0625rem] leading-relaxed sm:px-12 lg:px-16'
		>
			<Header />
			<slot />
			<Footer />
		</main>

		{/* The one console.log that is a feature rather than a leftover: opening
		    devtools on a security blog is a reasonable thing to do, and this is
		    the reward for it. Deliberate — do not strip it as debug output. */}
		<script>
			console.log(
				'%c hdbreaker %c one post is not in the index. it is not a bug.\n%c   /.well-known/security.txt',
				'background:#57FD6B;color:#0A0A0A;font-weight:700;padding:2px 6px;border-radius:3px',
				'color:#A0A0A0',
				'color:#57FD6B'
			)
		</script>
	</body>
</html>
