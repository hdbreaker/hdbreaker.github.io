---
import type { SiteMeta } from '@/types'

import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import ThemeProvider from '@/components/ThemeProvider.astro'

import { siteConfig } from '@/site-config'

interface Props {
	meta: SiteMeta
}

const {
	meta: {
		altSlug,
		articleDate,
		description = siteConfig.description,
		keywords,
		lang,
		noindex,
		ogImage,
		publishDate,
		title,
		updatedDate
	}
} = Astro.props

// Spanish posts must not be served as English: it hurts SEO and screen readers.
const htmlLang = lang === 'es' ? 'es' : siteConfig.lang
---

<html lang={htmlLang} class='dark'>
	<head>
		<BaseHead
			altSlug={altSlug}
			articleDate={articleDate}
			description={description}
			keywords={keywords}
			lang={lang}
			noindex={noindex}
			ogImage={ogImage}
			publishDate={publishDate}
			title={title}
			updatedDate={updatedDate}
		/>
	</head>

	<body class='flex justify-center bg-[#0A0A0A] text-[#F5F5F5]'>
		<ThemeProvider />
		<main
			class='flex min-h-screen w-screen max-w-[70rem] flex-col items-center px-8 pb-16 pt-8 font-satoshi text-[1.0625rem] leading-relaxed sm:px-12 lg:px-16'
		>
			<Header />
			<slot />
			<Footer />
		</main>

		{/* The way in to /0x00. Deliberately almost nothing: one word so it reads as
		    a tell rather than noise, and the path in hex so it has to be decoded
		    instead of clicked. Anyone who reads source will find it; nobody will
		    trip over it. Do not expand this into an explanation.

		    Written as a literal comment on purpose. Passing it to `set:html` as a
		    static string attribute escapes it into &lt;!-- and renders it as
		    visible text on the page. */}
		<!-- unlisted: 2f30783030 -->
	</body>
</html>
